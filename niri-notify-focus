#!/usr/bin/env python3
"""niri-notify-focus: Focus source window when a notification is clicked.

Monitors D-Bus notification traffic via BecomeMonitor, maps sender PIDs
to niri windows by walking the process tree, and focuses the correct
window when the user clicks a notification action or dismisses it.

Usage:
    niri-notify-focus        # run in foreground
    niri-notify-focus -d     # debug logging

Requires: niri, python3, dbus-python, pygobject
"""

import json
import logging
import os
import signal
import subprocess
import sys
import threading
import time
import tomllib

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

LOG_FMT = "%(asctime)s %(levelname)s %(message)s"
log = logging.getLogger("niri-notify-focus")

MAX_ENTRIES = 200

DEFAULTS = {
    "effect": "shrink",
    "pulse_pixels": 50,
}


def load_config():
    """Load TOML config from XDG_CONFIG_HOME, falling back to defaults."""
    config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    config_path = os.path.join(config_home, "niri-notify-focus", "config.toml")

    cfg = dict(DEFAULTS)
    if not os.path.isfile(config_path):
        log.debug("No config file at %s, using defaults", config_path)
        return cfg

    try:
        with open(config_path, "rb") as f:
            user_cfg = tomllib.load(f)
        cfg.update(user_cfg)
        log.info("Loaded config from %s", config_path)
    except Exception as e:
        log.warning("Failed to parse %s: %s — using defaults", config_path, e)

    if cfg["effect"] not in ("shrink", "expand", "none"):
        log.warning("Unknown effect %r, falling back to 'shrink'", cfg["effect"])
        cfg["effect"] = "shrink"

    return cfg


def get_niri_windows():
    """Get all niri windows as a list of dicts."""
    try:
        result = subprocess.run(
            ["niri", "msg", "--json", "windows"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        return json.loads(result.stdout)
    except Exception:
        return []


def get_ppid(pid):
    """Get parent PID from /proc."""
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split(":")[1].strip())
    except (FileNotFoundError, PermissionError, ValueError):
        pass
    return None


def find_window_for_pid(sender_pid):
    """Walk up the PID tree to find the matching niri window.

    Returns (window_id, window_title) or (None, None).
    """
    windows = get_niri_windows()
    window_pids = {w["pid"]: (w["id"], w.get("title", "")) for w in windows}

    current = sender_pid
    visited = set()
    while current and current > 1 and current not in visited:
        visited.add(current)
        if current in window_pids:
            return window_pids[current]
        current = get_ppid(current)
    return None, None


def _niri_action(*args):
    """Run a niri action without blocking (fire-and-forget)."""
    try:
        subprocess.Popen(
            ["niri", "msg", "action", *args],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        log.error("niri action %s failed: %s", args, e)


def _niri_action_sync(*args):
    """Run a niri action and wait for completion."""
    try:
        subprocess.run(
            ["niri", "msg", "action", *args],
            capture_output=True,
            timeout=2,
        )
    except Exception as e:
        log.error("niri action %s failed: %s", args, e)


def _get_window_geometry(window_id):
    """Return {tile: (w, h), win: (w, h)} for a window ID, or None.

    Looked up by ID from the full window list, so it is unaffected by
    whatever window happens to be focused at the time.
    """
    try:
        result = subprocess.run(
            ["niri", "msg", "--json", "windows"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        for w in json.loads(result.stdout):
            if int(w["id"]) == window_id:
                layout = w["layout"]
                return {
                    "tile": tuple(round(v) for v in layout["tile_size"]),
                    "win": tuple(int(v) for v in layout["window_size"]),
                }
    except Exception:
        pass
    return None


def _wait_for_window_id(window_id, timeout_s=1.0):
    """Block (on a worker thread) until the given window is the focused one.

    `focus-window` is issued asynchronously; a size action issued before
    that lands would apply to the previously focused window instead.
    """
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        try:
            result = subprocess.run(
                ["niri", "msg", "--json", "focused-window"],
                capture_output=True,
                text=True,
                timeout=1,
            )
            if int(json.loads(result.stdout)["id"]) == window_id:
                return True
        except Exception:
            pass
        time.sleep(0.02)
    return False


def _window_action(window_id, *args, id_flagged=False):
    """Focus a window by ID, wait for it, then run a niri action on it.

    `set-column-width` has no `--id` option, so the column action has to
    target the focused window. `set-window-height`, `reset-window-height`
    and `maximize-window-to-edges` do accept `--id`; passing it makes those
    commands immune to focus moving away mid-pulse.
    """
    _niri_action_sync("focus-window", "--id", str(window_id))
    if not _wait_for_window_id(window_id):
        return False
    if id_flagged:
        _niri_action_sync(*args, "--id", str(window_id))
    else:
        _niri_action_sync(*args)
    return True


def _restore_geometry(window_id, before, attempts=3):
    """Return the window to its snapshot, retrying if focus drifted.

    A niri size action applies to the focused window. If focus moves during
    the pulse (another notification, a new window opening), a restore can
    land on the wrong window and leave the target shrunk. Verify and retry.
    """
    for attempt in range(1, attempts + 1):
        ok = _window_action(window_id, "set-column-width", str(before["win"][0]))
        ok = ok and _window_action(window_id, "reset-window-height", id_flagged=True)
        if not ok:
            time.sleep(0.1)
            continue

        after = _get_window_geometry(window_id)
        if after is not None and after["win"] == before["win"]:
            return after

        # A user-fixed height does not come back from reset-window-height.
        if after is not None and abs(after["win"][1] - before["win"][1]) > 2:
            _window_action(
                window_id, "set-window-height", str(before["win"][1]), id_flagged=True
            )
            after = _get_window_geometry(window_id)
            if after is not None and after["win"] == before["win"]:
                return after

        # Maximized-to-edges is cleared by any size change; re-apply it when
        # the window filled its tile beforehand (tile size met window size).
        if before["tile"] == before["win"]:
            _window_action(window_id, "maximize-window-to-edges", id_flagged=True)
            time.sleep(0.2)
            after = _get_window_geometry(window_id)
            if after is not None and after["win"] == before["win"]:
                return after

        log.debug("Restore attempt %d for window %d did not settle", attempt, window_id)
        time.sleep(0.1)

    after = _get_window_geometry(window_id)
    if after is not None and after["win"] != before["win"]:
        log.warning(
            "Window %d geometry %s -> %s not fully restored",
            window_id,
            before["win"],
            after["win"],
        )
    return after


def flash_and_focus_window(window_id, effect="shrink", pulse_px=50):
    """Focus window and optionally pulse its size as a visual cue.

    Args:
        window_id: The niri window ID to focus.
        effect: "shrink" (inward pulse), "expand" (outward pulse), or "none".
        pulse_px: Pixels to offset during the pulse animation.

    Three rules keep the window's geometry intact:

    1. The target's geometry is snapshotted by window ID *before* anything
       else, and restored with absolute values. A relative undo (`+50`)
       drifts whenever niri clamps the pulse: on a column already at full
       width `-50` is clamped but `+50` is not, leaving the column wider
       than the screen. Absolute pixels are exact.
    2. Every command is synchronous, on a worker thread. A fire-and-forget
       pulse could be delivered after the restore and freeze the window at
       its shrunk size.
    3. The restore is verified against the snapshot and retried, because a
       niri size action applies to whichever window is focused.

    The snapshot also records whether the column was maximized-to-edges
    (tile size equals window size), because any size change clears that
    state and it has to be re-applied.
    """
    _niri_action("focus-window", "--id", str(window_id))
    log.info("Focused window %d", window_id)

    if effect == "none":
        return

    sign = -1 if effect == "shrink" else 1

    def _run_pulse():
        before = _get_window_geometry(window_id)
        if before is None:
            log.warning("Window %d vanished, skipping pulse", window_id)
            return

        # A full-bleed window (tile size meets window size) is maximized to
        # the edges. Any size change clears that state and re-applying it is
        # not always reliable, so focus without pulsing.
        if before["tile"] == before["win"]:
            log.debug("Window %d is full-bleed, focusing without pulse", window_id)
            _window_action(window_id)
            return

        if not _window_action(window_id, "set-column-width", f"{sign * pulse_px:+d}"):
            log.warning("Window %d did not gain focus, skipping pulse", window_id)
            return
        _window_action(
            window_id, "set-window-height", f"{sign * pulse_px:+d}", id_flagged=True
        )
        time.sleep(0.35)

        _restore_geometry(window_id, before)

    # Run the blocking pulse sequence on a worker thread so it cannot
    # stall the GLib main loop (which must keep processing D-Bus
    # notification traffic). The 100 ms delay lets the async focus settle.
    GLib.timeout_add(
        100,
        lambda: (threading.Thread(target=_run_pulse, daemon=True).start(), False)[1],
    )


def get_dbus_sender_pid(lookup_bus, sender_name):
    """Get PID of a D-Bus connection via GetConnectionUnixProcessID."""
    try:
        return int(
            lookup_bus.call_blocking(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetConnectionUnixProcessID",
                "s",
                (sender_name,),
            )
        )
    except Exception:
        return None


def run_monitor(cfg):
    """Run the BecomeMonitor loop."""
    # Separate connection for D-Bus PID lookups (BecomeMonitor is read-only)
    lookup_bus = dbus.SessionBus()

    bus = dbus.SessionBus(private=True)
    bus.call_blocking(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus.Monitoring",
        "BecomeMonitor",
        "asu",
        (
            [
                # Catch Notify calls, ActionInvoked/NotificationClosed signals
                "interface='org.freedesktop.Notifications'",
                # Catch method returns (needed to get notification IDs)
                "type='method_return'",
            ],
            0,
        ),
    )

    # "sender_busname:serial" -> (window_id, title)
    pending = {}
    # notification_id -> (window_id, title)
    notif_to_window = {}

    def msg_filter(conn, msg):
        msg_type = msg.get_type()
        member = msg.get_member()
        sender = msg.get_sender()
        dest = msg.get_destination()
        serial = msg.get_serial()
        reply_serial = msg.get_reply_serial()

        # --- Notify method call: extract sender PID, resolve window ---
        if msg_type == 1 and member == "Notify":
            args = msg.get_args_list()
            hints = dict(args[6]) if len(args) > 6 else {}

            # Try sender-pid hint first, then D-Bus connection PID
            sender_pid = int(hints.get("sender-pid", 0))
            if not sender_pid:
                sender_pid = get_dbus_sender_pid(lookup_bus, sender) or 0

            if sender_pid:
                key = f"{sender}:{serial}"
                # Resolve window eagerly while sender PID is still alive
                window_id, title = find_window_for_pid(sender_pid)
                if window_id is not None:
                    pending[key] = (window_id, title)
                    log.debug(
                        "Notify pid=%d -> window %d (%s)",
                        sender_pid,
                        window_id,
                        title[:40],
                    )

        # --- Method return: map notification_id to window ---
        elif msg_type == 2 and reply_serial:
            args = msg.get_args_list()
            # Notify returns a single UInt32 (the notification ID)
            if len(args) == 1 and isinstance(args[0], dbus.UInt32):
                notif_id = int(args[0])
                key = f"{dest}:{reply_serial}"
                if key in pending:
                    notif_to_window[notif_id] = pending.pop(key)
                    log.info(
                        "Tracked notif %d -> window %d (%s)",
                        notif_id,
                        notif_to_window[notif_id][0],
                        notif_to_window[notif_id][1][:40],
                    )
                    _cleanup(notif_to_window)

        # --- ActionInvoked signal: user clicked an action button ---
        elif msg_type == 4 and member == "ActionInvoked":
            args = msg.get_args_list()
            if len(args) >= 1:
                notif_id = int(args[0])
                action_key = str(args[1]) if len(args) > 1 else ""
                if notif_id in notif_to_window:
                    wid, title = notif_to_window[notif_id]
                    log.info(
                        "ActionInvoked notif=%d action=%s -> focus window %d (%s)",
                        notif_id,
                        action_key,
                        wid,
                        title[:40],
                    )
                    flash_and_focus_window(wid, cfg["effect"], cfg["pulse_pixels"])

        # --- NotificationClosed signal: user dismissed ---
        elif msg_type == 4 and member == "NotificationClosed":
            args = msg.get_args_list()
            if len(args) >= 2:
                notif_id = int(args[0])
                reason = int(args[1])
                # reason 2 = dismissed by user
                if reason == 2 and notif_id in notif_to_window:
                    wid, title = notif_to_window[notif_id]
                    # Only focus if ActionInvoked didn't already handle it
                    # (DMS sends both ActionInvoked then NotificationClosed)
                    log.debug("NotificationClosed notif=%d reason=%d", notif_id, reason)
                notif_to_window.pop(notif_id, None)

        return dbus.lowlevel.HANDLER_RESULT_HANDLED

    bus.add_message_filter(msg_filter)
    loop = GLib.MainLoop()

    def on_signal(signum, frame):
        log.info("Signal %d received, exiting", signum)
        loop.quit()
        sys.exit(0)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    log.info("Monitoring notifications (pid=%d)...", os.getpid())
    loop.run()


def _cleanup(notif_to_window):
    """Evict oldest entries if map grows too large."""
    if len(notif_to_window) > MAX_ENTRIES:
        for k in sorted(notif_to_window)[: MAX_ENTRIES // 2]:
            notif_to_window.pop(k, None)


def main():
    level = logging.DEBUG if "-d" in sys.argv else logging.INFO
    logging.basicConfig(format=LOG_FMT, level=level)
    DBusGMainLoop(set_as_default=True)

    cfg = load_config()
    log.info("effect=%s, pulse_pixels=%d", cfg["effect"], cfg["pulse_pixels"])

    while True:
        try:
            run_monitor(cfg)
        except dbus.exceptions.DBusException as e:
            log.warning("D-Bus error: %s — retrying in 5s", e)
            time.sleep(5)
        except Exception as e:
            log.error("Unexpected error: %s — retrying in 5s", e)
            time.sleep(5)


if __name__ == "__main__":
    main()
